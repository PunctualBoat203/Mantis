import { events } from 'mantis:events';
import { recipes } from 'minecraft:recipes';

events.on('recipes', () => {
  recipes.shapeless('mantis:stick_from_planks', recipes.item('minecraft:stick', 2), ['#minecraft:planks']);
  recipes.smelting('mantis:recycle_sword', 'minecraft:iron_nugget', 'minecraft:iron_sword')
    .experience(0.2).cookingTime(100);

  // The same operations accept any installed recipe serializer's JSON.
  // Use an existing recipe's complete JSON with recipes.replace(id, json),
  // or change an exact field with recipes.set({ id: 'modid:recipe' }, '/field', value).
  // For input/output fields declared by a schema or using common field names:
  // recipes.replaceInput({ mod: 'modid' }, 'minecraft:iron_ingot', 'minecraft:copper_ingot');
});
